---
interface Source { label: string; url: string; type: string }
interface Item {
  slug: string; publishedAt: string; category: string; title: string; summary: string;
  fact: string; impact: string; uncertainty: string; evidenceLevel: string; tags: string[]; sources: Source[];
}
interface Props { item: Item; featured?: boolean }
const { item, featured = false } = Astro.props;
---

<article class:list={['intel-card', { featured }]} data-category={item.category}>
  <div class="intel-topline">
    <span class="intel-category">{item.category}</span>
    <span class="evidence-badge">{item.evidenceLevel} 级证据</span>
    <time datetime={item.publishedAt}>{item.publishedAt}</time>
  </div>
  <h3>{item.title}</h3>
  <p class="intel-summary">{item.summary}</p>
  <div class="intel-analysis">
    <p><strong>事实</strong>{item.fact}</p>
    <p><strong>影响</strong>{item.impact}</p>
    <p><strong>边界</strong>{item.uncertainty}</p>
  </div>
  <div class="intel-footer">
    <div class="tag-list">{item.tags.map(tag => <span>{tag}</span>)}</div>
    <a href={item.sources[0].url} target="_blank" rel="noreferrer">原始来源 ↗</a>
  </div>
</article>
