---
interface Props { pathname: string }
const { pathname } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: '/', label: '首页', match: `${base}/` },
  { href: '/frontier/', label: '前沿', match: `${base}/frontier/` },
  { href: '/learn/', label: '学习', match: `${base}/learn/` },
  { href: '/method/', label: '方法', match: `${base}/method/` }
];
---

<header class="site-header">
  <a class="brand" href={`${base}/`} aria-label="AI Frontier Atlas 首页">
    <span class="brand-mark">A<span>F</span></span>
    <span class="brand-copy"><strong>AI FRONTIER ATLAS</strong><small>前沿图谱</small></span>
  </a>
  <nav aria-label="主导航">
    {nav.map(item => (
      <a href={`${base}${item.href}`} class:list={{ active: item.href === '/' ? pathname === item.match : pathname.startsWith(item.match) }}>{item.label}</a>
    ))}
  </nav>
  <a class="header-status" href={`${base}/method/`}><span></span> 每日双更</a>
</header>
