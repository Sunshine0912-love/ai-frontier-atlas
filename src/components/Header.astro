---
interface Props { pathname: string }
const { pathname } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: '/', label: '研究台', en: 'DESK' },
  { href: '/frontier/', label: '前沿情报', en: 'INTELLIGENCE' },
  { href: '/learn/', label: '课程体系', en: 'CURRICULUM' },
  { href: '/method/', label: '研究方法', en: 'METHOD' }
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={`${base}/`} aria-label="AI Frontier Atlas 首页">
      <span class="brand-mark">AF</span>
      <span class="brand-copy"><strong>AI Frontier Atlas</strong><small>Research · Systems · Practice</small></span>
    </a>
    <nav aria-label="主导航">
      {nav.map(item => {
        const target = `${base}${item.href}`;
        const active = item.href === '/' ? pathname === target : pathname.startsWith(target);
        return <a href={target} class:list={{ active }}><span>{item.label}</span><small>{item.en}</small></a>;
      })}
    </nav>
    <a class="header-update" href={`${base}/method/`}>
      <span class="status-pulse"></span>
      <span><strong>DAILY REVIEW</strong><small>09:00 / 21:00 CST</small></span>
    </a>
  </div>
</header>
