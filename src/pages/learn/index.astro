---
import Layout from '../../components/Layout.astro';
import tracks from '../../data/tracks.json';
import lessons from '../../data/lessons.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const stages = [...new Set(tracks.map(track => track.stage))];
const trackById = Object.fromEntries(tracks.map(track => [track.id, track]));
---

<Layout title="课程体系｜AI Frontier Atlas" description="面向 AI 研究者与工程师的四阶段系统课程，覆盖机制、代码、实验和工程决策。">
  <section class="page-intro shell learn-intro">
    <p class="kicker">SYSTEMATIC CURRICULUM</p>
    <div><h1>四阶段<br />系统学习路径</h1><p>不沿热搜学习，沿知识依赖与能力目标学习。每节课程必须回答：机制是什么、代码在哪里、如何验证、何时采用。</p></div>
  </section>

  <section class="learning-standard shell">
    <div><span>01</span><strong>MECHANISM</strong><p>公式、张量与心智模型</p></div>
    <div><span>02</span><strong>CODE</strong><p>关键模块与数据路径</p></div>
    <div><span>03</span><strong>LAB</strong><p>可运行实验与成功标准</p></div>
    <div><span>04</span><strong>DECISION</strong><p>生产权衡与适用边界</p></div>
  </section>

  <section class="curriculum-map shell">
    {stages.map((stage, stageIndex) => (
      <section class="curriculum-stage">
        <header>
          <span>{String(stageIndex + 1).padStart(2, '0')}</span>
          <div><p>STAGE {stageIndex + 1}</p><h2>{stage.split(' · ')[1]}</h2></div>
          <p>{stageIndex === 0 ? '先建立表示、注意力和跨模态坐标系。' : stageIndex === 1 ? '理解规模化训练和偏好学习。' : stageIndex === 2 ? '把模型能力转成稳定、可测量的服务。' : '构建可控 Agent，并用评测守住上线边界。'}</p>
        </header>
        <div class="stage-tracks">
          {tracks.filter(track => track.stage === stage).map(track => {
            const trackLessons = lessons.filter(lesson => lesson.track === track.id).sort((a, b) => a.order - b.order);
            return (
              <article class={`track-module module-${track.color}`} id={track.id}>
                <div class="module-head">
                  <div><span>{track.number}</span><p>{track.status === 'available' ? 'AVAILABLE' : 'EXPANDING'}</p></div>
                  <div><h3>{track.title}</h3><p>{track.description}</p></div>
                  <dl>
                    <div><dt>课程</dt><dd>{trackLessons.length}/{track.plannedLessons}</dd></div>
                    <div><dt>实验</dt><dd>{track.labCount}</dd></div>
                  </dl>
                </div>
                <div class="module-context">
                  <div><strong>先修</strong><p>{track.prerequisites.length ? track.prerequisites.map(id => trackById[id]?.title).join('、') : '线性代数、概率与 Python'}</p></div>
                  <div><strong>能力目标</strong><ul>{track.outcomes.map(outcome => <li>{outcome}</li>)}</ul></div>
                </div>
                <div class="module-lessons">
                  {trackLessons.map(lesson => (
                    <a href={`${base}/learn/${lesson.slug}/`}>
                      <span>L{String(lesson.order).padStart(2, '0')}</span>
                      <div><strong>{lesson.title}</strong><p>{lesson.description}</p></div>
                      <em>{lesson.duration}</em><i>→</i>
                    </a>
                  ))}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </section>
</Layout>
