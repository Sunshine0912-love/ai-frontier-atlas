---
import Layout from '../../components/Layout.astro';
import tracks from '../../data/tracks.json';
import lessons from '../../data/lessons.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="系统学习路径｜AI Frontier Atlas" description="面向学生和从业者的 AI 关键技术系统学习路线。">
  <section class="page-hero shell compact learn-hero">
    <p class="eyebrow">SYSTEMATIC LEARNING</p>
    <h1>系统学习路径</h1>
    <p>沿依赖关系学习，而不是沿热搜学习。先建立概念地图，再进入张量、源码、系统权衡和生产验证。</p>
  </section>
  <section class="learning-contract shell">
    {['概念地图', '代码脉络', '工程意义', '自检问题'].map((item, index) => <div><span>0{index + 1}</span><strong>{item}</strong></div>)}
  </section>
  <section class="shell curriculum">
    {tracks.map(track => {
      const trackLessons = lessons.filter(lesson => lesson.track === track.id).sort((a, b) => a.order - b.order);
      return (
        <article class={`curriculum-track color-${track.color}`} id={track.id}>
          <div class="curriculum-head">
            <span>{track.number}</span>
            <div><h2>{track.title}</h2><p>{track.description}</p></div>
            <strong>{trackLessons.length} 节课程</strong>
          </div>
          {trackLessons.length ? (
            <div class="lesson-list">
              {trackLessons.map(lesson => (
                <a href={`${base}/learn/${lesson.slug}/`}>
                  <span class="lesson-order">{String(lesson.order).padStart(2, '0')}</span>
                  <div><h3>{lesson.title}</h3><p>{lesson.description}</p></div>
                  <span class="lesson-meta">{lesson.difficulty} · {lesson.duration}</span>
                  <span class="lesson-go">↗</span>
                </a>
              ))}
            </div>
          ) : <p class="track-pending">路线整理中：下一次维护将从核心依赖节点开始补齐。</p>}
        </article>
      );
    })}
  </section>
</Layout>
